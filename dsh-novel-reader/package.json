{
  "name": "@kingkk/dsh-novel-reader",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "novel", "reader", "小说", "阅读器"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinghard7/deekseek-harness-plugin-king.git",
    "directory": "dsh-novel-reader"
  },
  "files": ["lib", "cordis.patch.yml"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "description": "Novel reader for the dsh web GUI: online search via configurable sources, txt import/download, paginated reading with fully customizable hotkeys.",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
